{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run CLI register",
      "type": "debugpy",
      "request": "launch",
      "program": "src/tpl_deploy/cli.py",
      "args": ["register", "${input:remoteName}", "${input:remoteUrl}", "--debug"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run CLI unregister",
      "type": "debugpy",
      "request": "launch",
      "program": "src/tpl_deploy/cli.py",
      "args": ["unregister", "${input:remoteName}", "--debug"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run CLI list",
      "type": "debugpy",
      "request": "launch",
      "program": "src/tpl_deploy/cli.py",
      "args": ["list", "--debug"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run CLI update",
      "type": "debugpy",
      "request": "launch",
      "program": "src/tpl_deploy/cli.py",
      "args": ["update", "${input:remoteName}", "--debug"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run CLI show",
      "type": "debugpy",
      "request": "launch",
      "program": "src/tpl_deploy/cli.py",
      "args": ["config", "show", "--debug"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run CLI new",
      "type": "debugpy",
      "request": "launch",
      "program": "src/tpl_deploy/cli.py",
      "cwd": "${workspaceFolder}",
      "args": ["${input:templateName}", "${input:projectName}", "--debug"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Run PyTest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s", "-x"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Debug pytest (scratch)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-s", 
        "--log-cli-level=INFO", 
        "tests/scratch/test_scratch.py::test_scratch",
        "tests/unit/test_error.py::TestError"
      ],
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "Python: Debug pytest (asset)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-s", 
        "--log-cli-level=INFO", 
        "tests/unit/test_asset.py"
      ],
      "console": "internalConsole",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "remoteName",
      "type": "promptString",
      "description": "Remote name"
    },
    {
      "id": "templateName",
      "type": "promptString",
      "description": "Template name",
      "default": "console"
    },
    {
      "id": "projectName",
      "type": "promptString",
      "description": "Project name",
      "default": "MyConsole"
    },
    {
      "id": "remoteUrl",
      "type": "promptString",
      "description": "Remote URL",
      "default": "https://github.com/croicu/tpl-build/releases/latest/download/manifest.json"
    }
  ]
}
